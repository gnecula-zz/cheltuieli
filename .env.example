# Copiază în .env și completează valorile.

# Local (implicit): SQLite. Producție: PostgreSQL.
# DATABASE_URL=sqlite:///./cheltuieli.db
# DATABASE_URL=postgresql+psycopg://cheltuieli:PAROLA@db:5432/cheltuieli

SECRET_KEY=schimba-aceasta-cheie-in-productie
JWT_EXPIRE_HOURS=336

# Opțional — necesar pentru poze de bonuri și PDF-uri scanate
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

UPLOAD_DIR=./uploads

# Origini permise (dev Vite). În producție, domeniul public.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true pe HTTPS în producție
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

PUBLIC_URL=http://localhost:5173

# local (implicit) sau homeassistant (add-on Ingress)
AUTH_MODE=local

# Folosit de docker compose în producție
POSTGRES_PASSWORD=schimba-parola-postgres
